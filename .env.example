# Copy to .env.local (or run `npm run setup` to generate strong values).
# Never commit real values: every .env* file except this example is git-ignored.

# Initial passwords — used once to initialize an empty database, then stored only
# as scrypt hashes. Change them afterwards in Admin -> Settings.
INITIAL_SITE_PASSWORD=
INITIAL_ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# Database. Leave DATABASE_URL unset in development to use the embedded
# PostgreSQL (PGlite) database in ./.data/pglite.
# ----------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Percent-encode special characters in the password (# -> %23, @ -> %40).
#   Any sslmode/ssl* parameters in the URL are removed; TLS is set below.
#
# For the command-line scripts (db:status, db:migrate, credentials:reset), keep
# each remote URL in its own git-ignored file, for example .env.staging.local,
# and pass --env-file. With --env-file the scripts refuse to run if any
# DATABASE_* variable is also set in your shell (check: Test-Path Env:DATABASE_URL).
# db:migrate and credentials:reset also need --confirm-target <project-ref> for
# any database that is not on this machine: the Supabase project ref shown on
# the Target line (the part after "postgres." in the pooler user name), or the
# host name for other PostgreSQL servers.

# TLS: verify-full (default for remote hosts) | verify-ca | require (unverified) | disable (default for localhost)
# DATABASE_SSL=verify-full

# The server's CA certificate (Supabase: Database settings -> SSL Configuration).
# Either the PEM text (real newlines, \n escapes, or base64 all work) ...
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"
# ... or a path to the .crt file (keep it outside the repository or git-ignored):
# DATABASE_CA_CERT_FILE=./certs/prod-ca-2021.crt

# Schema migrations are applied automatically only to the embedded development
# database. Any PostgreSQL database (Supabase, staging, production, or local) is
# migrated with `npm run db:migrate`, which waits at most 5 seconds for a lock.
# true opts in to automatic migration for PostgreSQL; false turns it off everywhere.
# DATABASE_AUTO_MIGRATE=false

# Production refuses to start without DATABASE_URL. Single-server deployments
# that intentionally use the embedded database (never on Vercel) can opt in:
# ALLOW_EMBEDDED_DATABASE=true

# DATABASE_POOL_MAX=5                 # default 5, or 3 on Vercel
# DATABASE_CONNECT_TIMEOUT_MS=10000
# PGLITE_DATA_DIR=./.data/pglite
